{
  "name": "prytan",
  "version": "0.1.1",
  "description": "Your own memory of what you like and how you like things done, shared by every AI you use.",
  "mcpServers": {
    "prytan": {
      "httpUrl": "https://staging.prytan.ai/mcp",
      "timeout": 30000
    }
  },
  "contextFileName": "GEMINI.md",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${extensionPath}/hooks/prytan_hook.py\" start --host gemini --app \"Gemini CLI\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${extensionPath}/hooks/prytan_hook.py\" prompt --host gemini --app \"Gemini CLI\"",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
